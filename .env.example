# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Paste each value straight after the = sign, with no spaces or quotes.

# --- Claude (Anthropic): writes the prospect's replies and scores the call ---
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Only needed if the key is not tied to a workspace (Console -> Settings -> Workspaces).
ANTHROPIC_WORKSPACE_ID=

# --- ElevenLabs: the prospect's voice, and accurate transcription of what you say ---
# https://elevenlabs.io -> Developers -> API Keys. The key needs these permissions:
# Text to Speech, Voices (Read), and Speech to Text.
ELEVENLABS_API_KEY=
# "elevenlabs" = use ElevenLabs for the prospect's voice. Leave empty for the free (robotic) browser voice.
NEXT_PUBLIC_TTS_PROVIDER=elevenlabs
# "elevenlabs" = your speech is re-transcribed by ElevenLabs Scribe for accuracy. Leave empty for Chrome's recognition only.
NEXT_PUBLIC_STT_PROVIDER=elevenlabs

# --- Supabase (free plan) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never give this a NEXT_PUBLIC_ prefix and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Only confirmed email addresses on this domain (no @) can sign up and use the app.
ALLOWED_EMAIL_DOMAIN=mutherboard.com
# Same domain, shown to the sign-up form (must match the line above).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=mutherboard.com
# Where the app is served (used for the links in emails). Use http://localhost:3000 on your own computer.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The public address of the deployed app (for example https://your-app.onrender.com). Used for sign-in redirects.
# Read at run time, so no rebuild is needed to change it. Leave empty when running on your own computer.
SITE_URL=
