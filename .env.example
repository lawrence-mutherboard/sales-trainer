# --- Which AI to use ---
# "anthropic" = Claude (intended). "openai" = stand-in for trying the app before Anthropic access.
LLM_PROVIDER=openai

# --- OpenAI (only if LLM_PROVIDER=openai) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic (paid, pay-as-you-go; only if LLM_PROVIDER=anthropic) ---
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- Supabase (free plan) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never give this a NEXT_PUBLIC_ prefix and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Prospect voice ---
# "openai" = natural neural voice (uses OPENAI_API_KEY, a cent or two per minute of prospect speech).
# Leave blank for the free browser voice.
NEXT_PUBLIC_TTS_PROVIDER=openai

# --- Accurate speech recognition ---
# "openai" = your speech is re-transcribed by OpenAI for accuracy (uses OPENAI_API_KEY, a few cents per call).
# Leave blank for Chrome's built-in recognition only.
NEXT_PUBLIC_STT_PROVIDER=openai

# --- App ---
# Only Google accounts on this domain (no @) can sign in.
ALLOWED_EMAIL_DOMAIN=mutherboard.com
# Where the app is served (used for the Google sign-in redirect).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only needed if the key is not tied to a workspace (Anthropic Console -> Settings -> Workspaces). Paste the workspace ID after the = sign.
ANTHROPIC_WORKSPACE_ID=

# --- ElevenLabs voice (optional) ---
# TTS_BACKEND=elevenlabs uses ElevenLabs for the prospect voice (needs the key below). Anything else uses OpenAI.
# Paste the key after the = sign, no spaces or quotes. If the key is empty the app quietly keeps using OpenAI.
TTS_BACKEND=elevenlabs
ELEVENLABS_API_KEY=
